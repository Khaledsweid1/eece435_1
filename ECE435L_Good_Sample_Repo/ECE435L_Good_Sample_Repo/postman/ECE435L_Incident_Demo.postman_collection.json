            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 400\", function () { pm.response.to.have.status(400); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"incident_id\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
