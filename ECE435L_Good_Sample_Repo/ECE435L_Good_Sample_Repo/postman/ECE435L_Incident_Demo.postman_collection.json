    {
      "name": "Create incident (positive)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{employee_token}}"
          }
        ],
        "url": "{{base_url}}/incidents",
        "description": "Use employee token. Verify HTTP 201 and persisted row; Lina Khoury.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Suspicious sign-in\",\n  \"description\": \"User received an unexpected sign-in prompt\",\n  \"category\": \"Account compromise\",\n  \"severity\": \"High\",\n  \"affected_asset\": \"LAPTOP-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"incident_id\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Create incident (invalid severity)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
