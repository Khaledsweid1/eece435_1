        "description": "Validation negative case: unsupported severity returns 400; Lina Khoury.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Bad severity\",\n  \"description\": \"Test validation\",\n  \"category\": \"Phishing\",\n  \"severity\": \"EXTREME\",\n  \"affected_asset\": \"LAPTOP-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
